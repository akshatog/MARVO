# Copy to backend/.env on a fresh clone. Never commit populated credentials.
MARVO_DATA_MODE=DEMO
MARVO_USE_LLM=0

# Leave all provider keys empty for the blank-key demonstration.
# MARVO_USE_LLM alone does not disable every provider call path.
GROQ_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
SARVAM_API_KEY=

# Optional authenticated satellite product access.
MOSDAC_USER=
MOSDAC_PASS=
MARVO_MOSDAC_ENABLED=0
