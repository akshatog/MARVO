# Copy to frontend/.env.local. Vite embeds these values in the browser bundle.
# Use a Mapbox PUBLIC token (pk...), with appropriate URL restrictions.
# Never place backend provider keys or passwords in a VITE_ variable.
VITE_MAPBOX_TOKEN=

# Split deployment only: the Render backend URL INCLUDING /api, without a trailing slash.
# Leave blank for local Vite development or the combined Docker deployment.
# Example: https://your-render-backend.onrender.com/api
VITE_API_BASE_URL=
